    {
      "component_id": "c_023",
      "class": "android.widget.TextView",
      "text": "A 15% tip is expected by your server for good service and up to 20% if the service is exceptional, similar to the practices in the United States. If a service charge (propina) is added to the bill (usually 10%), then a tip/gratuity is not required to be given.",
      "content_desc": "",
      "resource_id": "",
      "clickable": false,
      "enabled": true,
      "focusable": false,
      "bounds": [
        25,
