    {
      "component_id": "c_031",
      "class": "com.ovuline.ovia.ui.view.TextView",
      "text": "Getting pregnant after birth control",
      "content_desc": "",
      "resource_id": "com.ovuline.fertility:id/title",
      "clickable": false,
      "enabled": true,
      "focusable": false,
      "bounds": [
