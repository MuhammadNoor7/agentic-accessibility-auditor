    {
      "component_id": "c_014",
      "class": "com.facebook.react.views.text.ReactTextView",
      "text": "A term formerly useful for describing websites consisting entirely of intentionally fabricated news stories, but now used to describe virtually anything that does not mesh with one's own views.",
