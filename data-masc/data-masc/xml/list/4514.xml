mily="default" class="com.ovuline.ovia.ui.view.TextView" visible-to-user="True" package="com.ovuline.fertility" enabled="True" pressed="not_pressed" scrollable-vertical="False"><wrapper><node value="android.support.v7.widget.AppCompatTextView" /><node value="android.widget.TextView" /><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="392" /><node value="35" /><node value="660" /><node value="120" /></wrapper><wrapper><node value="392" /><node value="315" /><node value="660" /><node value="400" /></wrapper></node><node text="Even a couple who stays perfectly healthy and does everything right fertility-wise may encounter difficulty getting pregnant out of mere bad luck, as it takes the average couple approximately six months to conceive. Ovia can help you get pregnant faster. Ovia helps you understand your fertility and general health in a completely new way. We help you identify trends and give you specific advice around what you should be doing to achieve your goals." resource-id="com.ovuline.fertility:id/description" adapter-view="False" pointer="2e211ec" scrollable-horizontal="False" selected="False" draw="False" focusable="False" long-clickable="False" visibility="visible" focused="False" clickable="False" abs-pos="True" font-family="default" class="com.ovuline.ovia.ui.view.TextView" visible-to-user="True" package="com.ovuline.fertility" enabled="True" pressed="not_pressed" scrollable-vertical="False"><wrapper><node value="android.support.v7.widget.AppCompatTextView" /><node value="android.widget.TextView" /><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="392" /><node value="120" /><node value="1384" /><node value="329" /></wrapper><wrapper><node value="392" /><node value="400" /><node value="1384" /><node value="609" /></wrapper></node></wrapper></node><node scrollable-horizontal="Fals