      ]
    },
    {
      "component_id": "c_030",
      "class": "android.widget.TextView",
      "text": "When traveling faster than 2 mph (~3km/h), the application will use your velocity (speed + direction) from the GPS to determine your heading. Otherwise, the phone's accelerometer and magnetometer sensors are used to calculate your direction.",
