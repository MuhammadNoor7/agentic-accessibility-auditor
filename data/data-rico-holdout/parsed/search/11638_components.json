      "visible": true
    },
    {
      "component_id": "c_019",
      "class": "android.widget.TextView",
      "text": "luteal phase",
      "content_desc": "",
      "hint": "",
      "resource_id": "",
      "clickable": false,
      "enabled": true,
      "focusable": false,
      "bounds": [
        70,
