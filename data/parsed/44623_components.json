      "bounds": [
        0,
        3047,
        757,
        3123
      ]
    },
    {
      "component_id": "c_032",
      "class": "android.widget.TextView",
      "text": "The orientation is locked to prevent the phone from changing orientations while driving due to rough terrain/roads. You can change the orientation that is locked or disabled it altogether in the settings.",
