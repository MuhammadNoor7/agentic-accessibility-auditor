      "is_dialog": false,
      "label_for": "",
      "text_size_sp": null,
      "text_color": null,
      "background_color": null,
      "visible": true
    },
    {
      "component_id": "c_018",
      "class": "android.widget.TextView",
      "text": "The ovulatory phase begins with a surge in luteinizing hormone and follicle-stimulating hormone levels. Luteinizing hormone stimulates egg release (ovulation), which usually occurs 16 to 32 hours after the surge begins.",
      "content_desc": "",
      "hint": "",
      "resource_id": "",
      "clickable": false,
      "enabled": true,
      "focusable": false,
      "bounds": [
        70,
        614,
        1370,
        851
      ],
      "focus_order": 18,
