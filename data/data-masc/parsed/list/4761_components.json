    {
      "component_id": "c_079",
      "class": "android.support.v7.widget.AppCompatTextView",
      "text": "Add the scallions and saute them, adding a little warm water to deglaze the pan. Let the scallions caramelize and get color, and then add the garlic. When the garlic starts to get a nice color, add the mushrooms. Stir constantly and slowly add enough warm water to help deglaze the pan. Because you are not using oil or fat to cook, you have to slowly nurse the flavors out of the ingredients.",
      "content_desc": "",
      "resource_id": "com.desertstorm.recipebook:id/direction",
      "clickable": false,
      "enabled": true,
      "focusable": false,
