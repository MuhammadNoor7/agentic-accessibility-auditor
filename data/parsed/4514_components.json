    {
      "component_id": "c_028",
      "class": "com.ovuline.ovia.ui.view.TextView",
      "text": "Tracking your fertility data can help increase your chances of conceiving in a given cycle from 20% to 70%, but logging and making sense of all of this data is easier said than done! Fortunately, Ovia has developed Ovia Fertility, a state-of-the-art ovulation predictor that helps you easily log and make sense of your data, providing you with accurate fertility projections, feedback, and analysis.",
      "content_desc": "",
      "resource_id": "com.ovuline.fertility:id/description",
