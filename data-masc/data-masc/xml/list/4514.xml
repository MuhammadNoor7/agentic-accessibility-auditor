mpatTextView" /><node value="android.widget.TextView" /><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="392" /><node value="35" /><node value="795" /><node value="120" /></wrapper><wrapper><node value="392" /><node value="683" /><node value="795" /><node value="768" /></wrapper></node><node text="Tracking your fertility data can help increase your chances of conceiving in a given cycle from 20% to 70%, but logging and making sense of all of this data is easier said than done! Fortunately, Ovia has developed Ovia Fertility, a state-of-the-art ovulation predictor that helps you easily log and make sense of your data, providing you with accurate fertility projections, feedback, and analysis." resource-id="com.ovuline.fertility:id/description" adapter-view="False" pointer="64023bb" scrollable-horizontal="False" selected="False" draw="False" focusable="False" long-clickable="False" visibility="visible" focused="False" clickable="False" abs-pos="True" font-family="default" class="com.ovuline.ovia.ui.view.TextView" visible-to-user="True" package="com.ovuline.fertility" enabled="True" pressed="not_pressed" scrollable-vertical="False"><wrapper><node value="android.support.v7.widget.AppCompatTextView" /><node value="android.widget.TextView" /><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="392" /><node value="120" /><node value="1384" /><node value="329" /></wrapper><wrapper><node value="392" /><node value="768" /><node value="1384" /><node value="977" /></wrapper></node></wrapper></node><node scrollable-horizontal="False" draw="True" clickable="True" pressed="not_pressed" focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="1d460d8" class="android.widget.RelativeLayout" visible-to-user="True"><wrapper><node value="android.view.ViewGroup" /><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="0" /><node value="1016" /><node value="1440" /><node value="1380" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="0" /><node value="736" /><node value="1440" /><node value="1100" /></wrapper><wrapper><node resource-id="com.ovuline.fertility:id/image" adapter-view="False" pointer="e3342a9" scrollable-horizontal="False" selected="False" draw="False" focusable="False" long-clickable="False" visibility="visible" focused="False" clickable="False" abs-pos="True" class="android.support.v7.widget.AppCompatImageView" visible-to-user="True" package="com.ovuline.fertility" enabled="True" pressed="not_pressed" scrollable-vertical="False"><wrapper><node value="android.widget.ImageView" /><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="56" /><node value="42" /><node value="336" /><node value="322" /></wrapper><wrapper><node value="56" /><node value="1058" /><node value="336" /><node value="1338" /></wrapper></node><node text="Getting pregnant after birth control" resource-id="com.ovuline.fertility:id/title" adapter-view="False" pointer="bff3c31" scrollable-horizontal="False" selected="False" draw="False" focusable="False" long-clickable="False" visibility="visible" focused="False" clickable="False" abs-pos="True" font-family="default" class="com.ovuline.ovia.ui.view.TextView" visible-to-user="True" package="com.ovuline.fertility" enabled="True" pressed="not_pressed" scrollable-vertical="False"><wrapper><node value="android.support.v7.widget.AppCompatTextView" /><node value="android.widget.TextView" /><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="392" /><node value="35" /><node value="1279" /><node value="120" /></wrapper><wrapper><node value="392" /><node value="1051" /><node value="1279" /><node value="1136" /></wrapper></node><node text="Trying to conceive can be a new experience for lots of women, particularly those who spent years crossing their fingers and hoping NOT to get pregnant! Some women fear that their past use of birth control may permanently interfere with their chances of conceiving, but this is extremely rare. Whatever the method of birth control is, the great majority of women are able to conceive after taking birth control, even if their cycle takes some time to get back to normal." resource-id="com.ovuline.fertility:id/description" adapter-view="False" pointer="ee9bf16" scrollable-horizontal="False" selected="False" draw="False" focusable="False" long-clickable="False" visibility="visible" focused="False" clickable="False" abs-pos="True" font-family="default" class="com.ovuline.ovia.ui.view.TextView" visible-to-user="True" package="com.ovuline.fertility" enabled="True" pressed="not_pressed" scrollable-vertical="False"><wrapper><node value="android.support.v7.widget.AppCompatTextView" /><node value="android.widget.TextView" /><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="392" /><node value="120" /><node value="1384" /><node value="329" /></wrapper><wrapper><node value="392" /><node value="1136" /><node value="1384" /><node value="1345" /></wrapper></node></wrapper></node><node scrollable-horizontal="False" draw="True" clickable="True" pressed="not_pressed" focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="2c34097" class="android.widget.RelativeLayout" visible-to-user="True"><wrapper><node value="android.view.ViewGroup" /><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="0" /><n