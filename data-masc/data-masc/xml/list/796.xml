ips for Potty Training" focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="bc7d8c" class="android.widget.TextView" visible-to-user="True"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="70" /><node value="154" /><node value="1370" /><node value="266" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="70" /><node value="70" /><node value="1370" /><node value="182" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="1. Gather information" focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="4ca4cd5" class="android.widget.TextView" visible-to-user="True"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="70" /><node value="326" /><node value="1370" /><node value="402" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="70" /><node value="242" /><node value="1370" /><node value="318" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="Before you start, talk to friends, consult with your pediatrician, and read up on different approaches. Remember there is no 'one size fits all' approach to potty training!" focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="f49ccea" class="android.widget.TextView" visible-to-user="True"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="133" /><node value="402" /><node value="1370" /><node value="639" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="133" /><node value="318" /><node value="1370" /><node value="555" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="2. Trust your instincts, be flexible!" focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="5d7bbdb" class="android.widget.TextView" visible-to-user="True"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="70" /><node value="699" /><node value="1370" /><node value="775" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="70" /><node value="615" /><node value="1370" /><node value="691" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="You are the expert on your child. Go with what you think will work best for your child and for you, and if it doesn't work, adjust!" focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="e79e678" class="android.widget.TextView" visible-to-user="True"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="133" /><node value="775" /><node value="1370" /><node value="955" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="133" /><node value="691" /><node value="1370" /><node value="871" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="3. Give yourself time" focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="6efe151" class="android.widget.TextView" visible-to-user="True"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="70" /><node value="1015" /><node value="1370" /><node value="1091" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="70" /><node value="931" /><node value="1370" /><node value="1007" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="Many preschools require children to be diaper free prior to enrollment, but children often operate on their own timeline! Build in some wiggle room into your schedule if you can." focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="6fcdb6" class="android.widget.TextView" visible-to-user="True"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="133" /><node value="1091" /><node value="1370" /><node value="1328" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="133" /><node value="1007" /><node value="1370" /><node value="1244" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="4. Aim for consistency" focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="10c3ab7" class="android.widget.TextView" visible-to-user="True"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="70" /><node value="1388" /><node value="1370" /><node value="1464" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="70" /><node value="1304" /><node value="1370" /><node value="1380" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="Set up your potty training routine and rewards structure (if you choose to use one), but don’t worry too much if you can’t stick to it every day. Life happens." focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="ca2f224" class="android.widget.TextView" visible-to-user="True"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="133" /><node value="1464" /><node value="1370" /><node value="1644" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="133" /><node value="1380" /><node value="1370" /><node value="1560" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="5. Celebrate every step" focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="300418d" class="android.widget.TextView" visible-to-user="True"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="70" /><node value="1704" /><node value="1370" /><node value="1780" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="70" /><node value="1620" /><node value="1370" /><node value="1696" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="Potty training is a process. Start by celebrating the little things, like sitting on the potty for a few seconds at a time. Then move on to celebrating longer sits or first successes as your child catches on and improves with time." focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="b230f42" class="android.widget.TextView" visible-to-user="True"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="133" /><node value="1780" /><node value="1370" /><node value="2074" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="133" /><node value="1696" /><node value="1370" /><node value="1990" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="6. Allow for do-overs" focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="b9fcb53" class="android.widget.TextView" visible-to-user="True"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="70" /><node value="2134" /><node value="1370" /><node value="2210" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="70" /><node value="2050" /><node value="1370" /><node value="2126" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="If there’s a major interruption in your family’s schedule, and your child needs the comfort of the old routine, or you sense your child is just not ready yet, it’s OK to hang up the undies for a while." focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="82f0c90" class="android.widget.TextView" visible-to-user="True"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="133" /><node value="2210" /><node value="1370" /><node value="2392" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="133" /><node value="2126" /><node value="1370" /><node value="2363" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="7. Encourage independence" focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="93c6989" class="android.widget.TextView" visible-to-user="False"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="70" /><node value="2507" /><node value="1370" /><node value="2392" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="70" /><node value="2423" /><node value="1370" /><node value="2499" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="Help your child set a timer or Potty Watch to remind him to go. Give stickers or rewards when he remembers to go, whether it's with the help of a timer or all on his own!" focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="fd6dd8e" class="android.widget.TextView" visible-to-user="False"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="133" /><node value="2583" /><node value="1370" /><node value="2392" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="133" /><node value="2499" /><node value="1370" /><node value="2679" /></wrapper></node></wrapper><wrapper><node value="android.view.ViewGroup" /><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="0" /><node value="0" /><node value="1440" /><node value="2749" /></wrapper><wrapper><node value="0" /><node value="84" /><node value="1440" /><node value="2392" /></wrapper></node></wrapper></node></wrapper><wrapper><node value="android.view.ViewGroup" /><node value="android.view.View" 