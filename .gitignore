.env
.env.local
*.env


# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
.claude/

# Generic runtime uploads / outputs (not for Git)
# Note: do not use a bare `data/` or `outputs/` rule — it blocks the
# !exceptions below (validation_logs + samples must remain trackable).
data/parsed/
data/xml/
data/screenshots/
outputs/*
!outputs/validation_logs/
!outputs/validation_logs/**
outputs/validation_logs/_week6_tmp/
outputs/validation_logs/_week6_tmp/**
!outputs/week7_eval/
!outputs/week7_eval/**
!outputs/week7_summary.md
!outputs/violations/
outputs/violations/*
!outputs/violations/samples/
!outputs/violations/samples/**
!outputs/reports/
outputs/reports/*
!outputs/reports/samples/
!outputs/reports/samples/**

# Raw Rico source corpus (local only)
data/final_rico/
# 249MB — exceeds the 25MB size budget, not pushed
data/data-rico-holdout.zip

# MASC — ignore raw dataset; track parser output & splits only (on azeem branch)
data/data-masc/*
!data/data-masc/parsed/
!data/data-masc/parsed/**
!data/data-masc/splits/
!data/data-masc/splits/**

# Rico holdout — ignore raw dataset; track parser output + manifest metadata only
data/data-rico-holdout/*
!data/data-rico-holdout/parsed/
!data/data-rico-holdout/parsed/**
!data/data-rico-holdout/manifest/
!data/data-rico-holdout/manifest/*.csv
!data/data-rico-holdout/manifest/*.json
data/data-rico-holdout/manifest/_sheet_thumbs/
data/data-rico-holdout/manifest/category_sheets/
data/data-rico-holdout/manifest/google_sheets/
data/data-rico-holdout/manifest/*.xlsx

# Runtime auth/records/OTP JSON stores (local prototype DBs — do not commit user data)
backend/data/*.db.json
backend/data/*.json

# Local one-off helpers at repo root only
/_*.py

PROJECT_EXPLAINED.md

# Training checkpoints (.pt) are the only thing excluded under runs/ and models/ —
# multi-megabyte weights that bloat repo size. Everything else under runs/
# (manifests, crops, notebooks, confusion matrices, YOLO-format datasets) is
# tracked. Use Google Drive / S3 for checkpoint backups.
runs/**/*.pt
models/

# Editor backup/lock files (LibreOffice/Word autosave artifacts)
*.docx~
*.doc~
~$*.docx
~$*.doc

# Internship grading paperwork — personal/administrative, not project code
internship docs/
internship_docs/
