android.widget.TextView" visible-to-user="False"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="0" /><node value="2201" /><node value="1440" /><node value="2179" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="0" /><node value="2022" /><node value="1440" /><node value="2145" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="True" pressed="not_pressed" text="http://openweathermap.org" focusable="True" long-clickable="True" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="a1bc0dd" class="android.widget.TextView" visible-to-user="False"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="0" /><node value="2359" /><node value="599" /><node value="2179" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="0" /><node value="2180" /><node value="599" /><node value="2246" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="Can I use this app without GPS?" focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="a82a452" class="android.widget.TextView" visible-to-user="False"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="0" /><node value="2460" /><node value="800" /><node value="2179" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="0" /><node value="2281" /><node value="800" /><node value="2357" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="The core functionality of this application (speedometer, speed alerts, location, weather, altitude) requires GPS in order to work. Only the clock, compass, and custom launcher buttons will work without GPS." focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="11d2323" class="android.widget.TextView" visible-to-user="False"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="0" /><node value="2571" /><node value="1440" /><node value="2179" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="0" /><node value="2392" /><node value="1440" /><node value="2629" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="How does the compass work?" focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="a2ed020" class="android.widget.TextView" visible-to-user="False"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="0" /><node value="2843" /><node value="752" /><node value="2179" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="0" /><node value="2664" /><node value="752" /><node value="2740" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="When traveling faster than 2 mph (~3km/h), the application will use your velocity (speed + direction) from the GPS to determine your heading. Otherwise, the phone's accelerometer and magnetometer sensors are used to calculate your direction." focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="2188dd9" class="android.widget.TextView" visible-to-user="False"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="0" /><node value="2954" /><node value="1440" /><node value="2179" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="0" /><node value="2775" /><node value="1440" /><node value="3012" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="Why is the orientation locked?" focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="e82b39e" class="android.widget.TextView" visible-to-user="False"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="0" /><node value="3226" /><node value="757" /><node value="2179" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="0" /><node value="3047" /><node value="757" /><node value="3123" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="The orientation is locked to prevent the phone from changing orientations while driving due to rough terrain/roads. You can change the orientation that is locked or disabled it altogether in the settings." focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="a94ce7f" class="android.widget.TextView" visible-to-user="False"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="0" /><node value="3337" /><node value="1440" /><node value="2179" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="0" /><node value="3158" /><node value="1440" /><node value="3395" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="How accurate is the speedometer?" focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="d80ce4c" class="android.widget.TextView" visible-to-user="False"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="0" /><node value="3609" /><node value="870" /><node value="2179" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="0" /><node value="3430" /><node value="870" /><node value="3506" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="The speedometer is as accurate as your phone's GPS receiver. Therefore a G1's GPS receiver will not perform as well as a more recent Android device. Additionally, your GPS accuracy can be affected by satellite positions, noise in the radio signal, atmospheric conditions, and large barriers (such as buildings or mountains) to the signal. These conditions can produce GPS accuracy errors up to 30 meters. In order to alleviate these accuracy errors, the application will by default ignore speeds over 150 mph to prevent erroneous speed spikes (this can be disabled in the settings). The application will also ignore GPS data if the accuracy reported by the GPS is not at least 200 meters accurate (this value can be adjusted in the settings)." focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="97b2e95" class="android.widget.TextView" visible-to-user="False"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="0" /><node value="3720" /><node value="1440" /><node value="2179" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="0" /><node value="3541" /><node value="1440" /><node value="4234" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="What do the GPS statuses mean?" focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="de26baa" class="android.widget.TextView" visible-to-user="False"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="0" /><node value="4448" /><node value="834" /><node value="2179" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="0" /><node value="4269" /><node value="834" /><node value="4345" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="When your phone is 'Searching for GPS' then a GPS signal has not yet been acquired. When it finds a GPS lock, then status will change to 'GPS Found' and then 'GPS Locked' meaning that the application is ready to use GPS features (speedometer, weather, location, etc.). If the GPS is experiencing low accuracy issues, then the status will change to 'GPS Low Accuracy'. Beside of the GPS status description is a count of the number of satellites that are currently being used to determine your signal." focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="5b1d39b" class="android.widget.TextView" visible-to-user="False"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="0" /><node value="4559" /><node value="1440" /><node value="2179" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="0" /><node value="4380" /><node value="1440" /><node value="4845" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="How do the speed alerts work?" focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="128338" class="android.widget.TextView" visible-to-user="False"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="0" /><node value="5059" /><node value="775" /><node value="2179" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="0" /><node value="4880" /><node value="775" /><node value="4956" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="A speed alert will trigger when your current speed has exceeded the alert's speed limit. The alert can change the speedometer's color, the screen's border color and/or play a sound when activated. When your current speed drops to the alert's speed limit, then that specific alert will no longer be active. The current active speed alert will always be the highest speed alert below your current speed." focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="12d1f11" class="android.widget.TextView" visible-to-user="False"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="0" /><node value="5170" /><node value="1440" /><node value="2179" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="0" /><node value="4991" /><node value="1440" /><node value="5399" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="How do I enable sounds for speed alerts?" focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="7d39876" class="android.widget.TextView" visible-to-user="False"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="0" /><node value="5613" /><node value="1040" /><node value="2179" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="0" /><node value="5434" /><node value="1040" /><node value="5510" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="By default, none of the speed alerts have sounds enabled. Go to 'Manage Speed Alerts' and tap on the speed alert that you wish to enable sounds on. On the next screen, scroll down and enable sound alerts and choose a sound to play." focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="ed00e77" class="android.widget.TextView" visible-to-user="False"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="0" /><node value="5724" /><node value="1440" /><node value="2179" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="0" /><node value="5545" /><node value="1440" /><node value="5782" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="Why isn't the location/weather updating?" focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="a089ae4" class="android.widget.TextView" visible-to-user="False"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="0" /><node value="5996" /><node value="1020" /><node value="2179" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="0" /><node value="5817" /><node value="1020" /><node value="5893" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="These features require a GPS signal in order to work. Additionally, these features rely on 3rd party services and those services may sometimes not return data when requested. The application will keep retrying to update the information until it succeeds." focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="5339b4d" class="android.widget.TextView" visible-to-user="False"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="0" /><node value="6107" /><node value="1440" /><node value="2179" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="0" /><node value="5928" /><node value="1440" /><node value="6165" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="How do I switch to US customary/metric units?" focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="ad8c602" class="android.widget.TextView" visible-to-user="False"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="0" /><node value="6379" /><node value="1176" /><node value="2179" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="0" /><node value="6200" /><node value="1176" /><node value="6276" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="You can change the default speed alerts to mph or km/h by going to 'Manage Speed Alerts', pressing your menu button, and tapping 'Restore Default Alerts'. To change your speed, altitude, or temperature units, go to 'Settings'" focu