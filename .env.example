# Stage 3 explainer (src/explainer.py, src/llm_providers.py)
# Copy this file to .env and fill in the values for the ONE provider you use.
# .env is gitignored - never commit real keys.

# anthropic | openai | gemini | groq
LLM_PROVIDER=anthropic

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Groq ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Auth / JWT ---
JWT_SECRET=change-me-in-production

# Google Sign-In (OAuth 2.0 Web client ID from Google Cloud Console)
# Looks like: 123456789-xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_ID=228942611378-57q7js5sml71dbehvnq5qnu17p0uhunm.apps.googleusercontent.com

# --- Email OTP via Gmail SMTP (App Password) ---
# 1) Google Account → Security → 2-Step Verification → App passwords
# 2) Create an app password for "Mail"
# 3) Fill SMTP_USER / SMTP_FROM with your Gmail and SMTP_PASSWORD with the 16-char app password
#
# Recipients can be ANY domain (yahoo, outlook, university.edu, …).
# Only the *sending* account is Gmail.
SMTP_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=1
SMTP_USER=mnoorulhaq10@gmail.com
SMTP_FROM=mnoorulhaq10@gmail.com
SMTP_PASSWORD=etgk voor nkzd pcww 
# Set to 0 once real SMTP works (hides debug_code in API responses)
AUTH_DEV_SHOW_OTP=0
