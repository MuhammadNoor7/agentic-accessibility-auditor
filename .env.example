# Stage 3 explainer (src/explainer.py, src/llm_providers.py)
# Copy this file to .env and fill in the values for the ONE provider you use.
# .env is gitignored - never commit real keys.

# anthropic | openai | gemini | groq
LLM_PROVIDER=anthropic

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Groq ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Auth / JWT ---
JWT_SECRET=change-me-in-production

# Google Sign-In (OAuth 2.0 Web client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=

# Email OTP (password reset + signup verification)
# If SMTP_* is unset, codes are logged and returned as debug_code when AUTH_DEV_SHOW_OTP=1
AUTH_DEV_SHOW_OTP=1
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1

