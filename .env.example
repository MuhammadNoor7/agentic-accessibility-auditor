# Stage 3 explainer (src/explainer.py, src/llm_providers.py)
# Copy this file to .env and fill in the values for the ONE provider you use.
# .env is gitignored - never commit real keys.

# anthropic | openai | gemini | groq
LLM_PROVIDER=anthropic

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Groq ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
