<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Axion Audit Report — {{ report.screen_id }}</title>
  <style>
    :root {
      --ink: #0f1422;
      --muted: #5a6a8a;
      --border: #e2e6f0;
      --bg: #f4f6fb;
      --accent: #1d9e75;
      --card: #ffffff;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
      color: var(--ink);
      background: var(--bg);
      line-height: 1.5;
    }
    .page {
      max-width: 920px;
      margin: 0 auto;
      background: var(--card);
      box-shadow: 0 8px 32px rgba(15, 20, 34, 0.08);
    }
    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 28px 40px 20px;
      border-bottom: 2px solid #1a2240;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 20px;
      font-weight: 700;
    }
    .brand-mark {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      background: #1a2240;
      color: var(--accent);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
    }
    .meta { color: #94a3b8; font-size: 13px; }
    .content { padding: 32px 40px 40px; }
    h1 {
      margin: 0 0 8px;
      font-size: 28px;
    }
    .subtitle {
      color: var(--muted);
      margin: 0 0 24px;
      font-size: 14px;
    }
    .stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
      margin-bottom: 28px;
    }
    .stat {
      background: #f4f6fb;
      border-radius: 8px;
      padding: 12px 14px;
    }
    .stat.score { background: #f0fdf8; border: 1px solid #bbf7e0; }
    .stat-label {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.5px;
      color: var(--muted);
      margin: 0 0 4px;
      text-transform: uppercase;
    }
    .stat-value {
      margin: 0;
      font-size: 18px;
      font-weight: 700;
    }
    .columns {
      display: grid;
      grid-template-columns: 1fr 1.2fr;
      gap: 20px;
      margin-bottom: 28px;
    }
    .panel-title {
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.5px;
      color: var(--muted);
      margin: 0 0 8px;
      text-transform: uppercase;
    }
    .screenshot-box,
    .xml-box {
      border: 1px solid var(--border);
      border-radius: 8px;
      background: #f8fafc;
      min-height: 140px;
      overflow: hidden;
    }
    .screenshot-box img {
      display: block;
      width: 100%;
      height: auto;
    }
    .xml-box {
      background: #0f1422;
      color: #7dd3fc;
      padding: 14px 16px;
      font-family: Consolas, monospace;
      font-size: 11px;
      max-height: 220px;
      overflow: auto;
      white-space: pre-wrap;
      word-break: break-word;
    }
    .section-title {
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.5px;
      color: var(--muted);
      margin: 0 0 12px;
      text-transform: uppercase;
    }
    .violation {
      border: 1px solid var(--border);
      border-left: 4px solid #94a3b8;
      border-radius: 10px;
      padding: 16px 18px;
      margin-bottom: 12px;
      background: #fafbff;
      page-break-inside: avoid;
    }
    .violation-head {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
      margin-bottom: 8px;
    }
    .badge {
      display: inline-block;
      padding: 2px 10px;
      border-radius: 6px;
      font-size: 12px;
      font-weight: 700;
      color: #fff;
    }
    .issue-title {
      margin: 0 0 6px;
      font-size: 16px;
      font-weight: 700;
    }
    .issue-meta {
      color: #94a3b8;
      font-size: 12px;
    }
    .block {
      margin: 8px 0 0;
      font-size: 13px;
      color: #475569;
    }
    .fix {
      margin-top: 10px;
      background: #f0fdf8;
      border-radius: 6px;
      padding: 10px 12px;
      font-family: Consolas, monospace;
      font-size: 12px;
      color: #085041;
      white-space: pre-wrap;
    }
    .footer {
      text-align: center;
      color: #94a3b8;
      font-size: 12px;
      margin-top: 28px;
      padding-top: 16px;
      border-top: 1px solid var(--border);
    }
    @media print {
      body { background: #fff; }
      .page { box-shadow: none; max-width: none; }
    }
    @media (max-width: 720px) {
      .stats, .columns { grid-template-columns: 1fr; }
      .content, .header { padding-left: 20px; padding-right: 20px; }
    }
  </style>
</head>
<body>
  <div class="page">
    <header class="header">
      <div class="brand">
        <div class="brand-mark">A</div>
        <span>Axion</span>
      </div>
      <div class="meta">Generated {{ generated_at }}</div>
    </header>

    <main class="content">
      <h1>Accessibility audit report</h1>
      <p class="subtitle">
        Screen <strong>{{ report.screen_id }}</strong> · WCAG 2.2 AA aligned ·
        enrichment: {{ report.enrichment_mode or "template" }}
      </p>

      <div class="stats">
        <div class="stat score">
          <p class="stat-label">Accessibility score</p>
          <p class="stat-value">{{ report.accessibility_score if report.accessibility_score is defined else "—" }}</p>
        </div>
        <div class="stat">
          <p class="stat-label">Total issues</p>
          <p class="stat-value">{{ report.summary.total_issues }}</p>
        </div>
        <div class="stat">
          <p class="stat-label">Severity mix</p>
          <p class="stat-value" style="font-size:13px;">
            {{ report.summary.critical }} crit ·
            {{ report.summary.high }} high ·
            {{ report.summary.medium }} med ·
            {{ report.summary.low }} low
          </p>
        </div>
        <div class="stat">
          <p class="stat-label">Schema</p>
          <p class="stat-value">v{{ report.schema_version }}</p>
        </div>
      </div>

      <div class="columns">
        <div>
          <p class="panel-title">Screenshot</p>
          <div class="screenshot-box">
            {% if screenshot_data_uri %}
              <img src="{{ screenshot_data_uri }}" alt="Annotated screenshot for {{ report.screen_id }}" />
            {% else %}
              <div style="padding: 40px; text-align: center; color: #94a3b8;">No screenshot available</div>
            {% endif %}
          </div>
        </div>
        <div>
          <p class="panel-title">UIAutomator XML</p>
          <div class="xml-box">{{ xml_snippet or "XML source not available for this audit." }}</div>
        </div>
      </div>

      <p class="section-title">Detected violations ({{ violations|length }})</p>

      {% for violation in violations %}
      <article class="violation" style="border-left-color: {{ severity_colors.get(violation.severity, '#94a3b8') }};">
        <div class="violation-head">
          <div>
            <span class="badge" style="background: {{ severity_colors.get(violation.severity, '#94a3b8') }};">
              {{ violation.rule_id }} · {{ violation.severity }}
            </span>
            <span class="issue-meta">{{ violation.guideline }}</span>
          </div>
          <span class="issue-meta">{{ violation.component_id }} · {{ violation.class }}</span>
        </div>
        <h3 class="issue-title">{{ violation.issue }}</h3>
        <p class="block"><strong>Why it matters:</strong> {{ violation.agent_why_it_matters }}</p>
        <p class="block"><strong>Explanation:</strong> {{ violation.agent_explanation }}</p>
        <div class="fix"><strong>Developer fix</strong><br />{{ violation.agent_developer_fix }}</div>
      </article>
      {% endfor %}

      <p class="footer">
        Generated by Axion Accessibility Auditor · schema v{{ report.schema_version }} · WCAG 2.2 AA
      </p>
    </main>
  </div>
</body>
</html>
