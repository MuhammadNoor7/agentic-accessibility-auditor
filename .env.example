# Copy this file to .env and fill in real values. Never commit .env.

# --- Auth ---
JWT_SECRET=change-me-to-a-real-secret
GOOGLE_CLIENT_ID=
AUTH_DEV_SHOW_OTP=1

# --- SMTP (OTP mail) ---
SMTP_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=1
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- LLM provider (src/llm_providers.py) ---
# LLM_PROVIDER selects which of the 4 blocks below is actually used.
LLM_PROVIDER=groq

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Frontend (set in frontend/.env or your shell, not this file) ---
# VITE_API_BASE=http://127.0.0.1:8000
