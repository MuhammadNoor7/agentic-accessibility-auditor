    {
      "component_id": "c_028",
      "class": "android.widget.TextView",
      "text": "The core functionality of this application (speedometer, speed alerts, location, weather, altitude) requires GPS in order to work. Only the clock, compass, and custom launcher buttons will work without GPS.",
