ter-view="False" abs-pos="True" pointer="e0173e8" class="android.widget.ScrollView" visible-to-user="True"><wrapper><node value="android.widget.FrameLayout" /><node value="android.view.ViewGroup" /><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="0" /><node value="280" /><node value="1440" /><node value="2125" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="1440" /><node value="0" /><node value="2880" /><node value="1845" /></wrapper><wrapper><node scrollable-horizontal="False" draw="True" clickable="False" pressed="not_pressed" focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="55f3a01" class="android.widget.LinearLayout" visible-to-user="True"><wrapper><node value="android.view.ViewGroup" /><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="0" /><node value="280" /><node value="1440" /><node value="2125" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="0" /><node value="0" /><node value="1440" /><node value="4382" /></wrapper><wrapper><node text="Your questions answered" resource-id="au.edu.latrobe.asdetect:id/info_header" adapter-view="False" pointer="afe30a6" scrollable-horizontal="False" selected="False" draw="False" focusable="False" long-clickable="False" visibility="visible" focused="False" clickable="False" abs-pos="True" font-family="sans-serif" class="android.support.v7.widget.AppCompatTextView" visible-to-user="True" package="au.edu.latrobe.asdetect" enabled="True" pressed="not_pressed" scrollable-vertical="False"><wrapper><node value="android.widget.TextView" /><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="70" /><node value="70" /><node value="1058" /><node value="285" /></wrapper><wrapper><node value="70" /><node value="350" /><node value="1058" /><node value="565" /></wrapper></node><node text="How early is ‘early’?&#10;&#10;ASDetect is designed for assessing children aged between 11 and 30 months.&#10;&#10;What are the benefits of using ASDetect?&#10;&#10;ASDetect will provide you with a clear course of action for your next steps. Most children will show typical social and communication behaviours for their age. Some children – about 2% – will have a high likelihood of autism. The good news is that early intervention will help these children reach their full potential.&#10;&#10;Is it accurate?&#10;&#10;Over 30,000 children have been screened by 350 Maternal Child Health nurses across two large scale studies over the last 10 years. &#10;&#10;This surveillance tool is more than seven times more accurate than the next best tool. &#10;&#10;Of the small percentage of children that nurses referred for a formal assessment, 81% had autism. &#10;&#10;What about my information?&#10;&#10;La Trobe University takes your privacy very seriously. Your details are securely stored according to the La Trobe University privacy policy. For further details, please click here&#10;&#10;What do ‘mostly’ and ‘rarely’ mean?&#10;&#10;We know things are never black and white, especially where children are concerned and it’s the same for this application. Throughout each assessment, you will be asked whether your child, “MOSTLY” or “RARELY” displays a certain behaviour. “RARELY” means that although your child will sometimes display the behaviour it is not frequent, while “MOSTLY” means that this behaviour is frequently displayed and consistent.&#10;&#10;This application is NOT a diagnosis or a replacement for a professional assessment. It will provide you with some guidance as to whether you should seek a developmental assessment for your child.&#10;&#10;" resource-id="au.edu.latrobe.asdetect:id/info_text" adapter-view="False" pointer="7717ae7" scrollable-horizontal="False" selected="False" draw="False" focusable="True" long-clickable="True" visibility="visible" focused="False" clickable="True" abs-pos="True" font-family="sans-serif-light" class="android.support.v7.widget.AppCompatTextView" visible-to-user="True" package="au.edu.latrobe.asdetect" enabled="True" pressed="not_pressed" scrollable-vertical="False"><wrapper><node value="android.widget.TextView" /><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="70" /><node value="355" /><node value="1370" /><node value="4382" /></wrapper><wrapper><node value="70" /><node value="635" /><node value="1370" /><node value="2125" /></wrapper></node></wrapper></node></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" focusable="True" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="True" adapter-view="False" abs-pos="True" pointer="283b32e" class="android.widget.ScrollView" visible-to-user="False"><wrapper><node value="android.widget.FrameLayout" /><node value="android.view.ViewGroup" /><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="1440" /><node value="280" /><node value="1440" /><node value="2125" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="2880" /><node value="0" /><node value="4320" /><node value="1845" /></wrapper><wrapper><node scrollable-horizontal="False" draw="True" clickable="False" pressed="not_pressed" focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="63f7ecf" class="android.widget.LinearLayout" visible-to-user="False"><wrapper><node value="android.view.ViewGroup" /><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="1440" /><node value="280" /><node value="1440" /><node value="2125" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="0" /><node value="0" /><node value="1440" /><node value="3360" /></wrapper><wrapper><node text="World class research" resource-id="au.edu.latrobe.asdetect:id/info_header" adapter-view="False" pointer="4c6405c" scrollable-horizontal="False" selected="False" draw="False" focusable="False" long-clickable="False" visibility="visible" focused="False" clickable="False" abs-pos="True" font-family="sans-serif" class="android.support.v7.widget.AppCompatTextView" visible-to-user="False" package="au.edu.latrobe.asdetect" enabled="True" pressed="not_pressed" scrollable-vertical="False"><wrapper><node value="android.widget.TextView" /><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="70" /><node value="70" /><node value="904" /><node value="285" /></wrapper><wrapper><node value="1510" /><node value="350" /><node value="1440" /><node value="565" /></wrapper></node><node text="The research underpinning ASDetect originally began as part of a PhD commenced by Josephine Barbaro. Dr Barbaro is now the lead clinician in the Early Assessment Clinic at the Olga Tennison Autism Research Centre at La Trobe University, Melbourne, Australia. In 2006 Dr Barbaro initiated a program using 240 Maternal Child Health nurses to monitor social attention and communication behaviours in over 22,000 children aged between 12 and 24 months. &#10;&#10;In 2013, she ran a second study of 14,000 children with 110 nurses. This developmental surveillance program for Autism Spectrum Disorders, the Social Attention and Communication Study (SACS), has been translated and disseminated widely, both within Australia and internationally. &#10;&#10;The assessment process on which this application is based has been remarkably accurate and effective. In our studies, 81% of children who were identified as having a high likelihood for autism by Maternal Child Health nurses, did in fact have autism. Many of the remaining children who were assessed with a high likelihood had other related developmental conditions, such as language or developmental delays. &#10;&#10;You can read both academic papers discussing the SACS here: &#10;&#10;2010 http://www.ncbi.nlm.nih.gov/pubmed/20495475 &#10;&#10;2013 http://www.ncbi.nlm.nih.gov/pubmed/22735682 &#10;&#10;" resource-id="au.edu.latrobe.asdetect:id/info_text" adapter-view="False" pointer="32d9f65" scrollable-horizontal="False" selected="False" draw="False" focusable="True" long-clickable="True" visibility="visible" focused="False" clickable="True" abs-pos="True" font-family="sans-serif-light" class="android.support.v7.widget.AppCompatTextView" visible-to-user="False" package="au.edu.latrobe.asdetect" enabled="True" pressed="not_pressed" scrollable-vertical="False"><wrapper><node value="android.widget.TextView" /><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="70" /><node value="355" /><node value="1370" /><node value="3360" /></wrapper><wrapper><node value="1510" /><node value="635" /><node value="1440" /><node value="2125" /></wrapper></node></wrapper></node></wrapper></node></wrapper><wrapper><node value="android.view.ViewGroup" /><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="0" /><node value="0" /><node value="1440" /><node value="1845" /></wrapper><wrapper><node value="0" /><node value="280" /><node value="1440" /><node value="2125" /></wrapper></node><node resource-id="au.edu.latrobe.asdetect:id/indicator" adapter-view="False" pointer="46de694" scrollable-horizontal="False" selected="False" draw="False" focusable="False" long-clickable="False" visibility="visible" focused="False" clickable="False" abs-pos="True" class="com.viewpagerindi