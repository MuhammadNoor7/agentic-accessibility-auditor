        4956
      ]
    },
    {
      "component_id": "c_038",
      "class": "android.widget.TextView",
      "text": "A speed alert will trigger when your current speed has exceeded the alert's speed limit. The alert can change the speedometer's color, the screen's border color and/or play a sound when activated. When your current speed drops to the alert's speed limit, then that specific alert will no longer be active. The current active speed alert will always be the highest speed alert below your current speed.",
      "content_desc": "",
      "resource_id": "",
      "clickable": false,
      "enabled": true,
      "focusable": false,
      "bounds": [
