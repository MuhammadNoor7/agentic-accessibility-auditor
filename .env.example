# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit secrets (API keys, App Passwords, JWT secrets).

# anthropic | openai | gemini | groq
LLM_PROVIDER=anthropic

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Groq ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Auth / JWT ---
JWT_SECRET=change-me-in-production

# Google Sign-In (OAuth 2.0 Web client ID from Google Cloud Console)
# Public client ID is OK in this example file.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# --- Email OTP via Gmail SMTP (App Password) ---
# 1) Google Account → Security → 2-Step Verification → App passwords
# 2) Create an app password for "Mail"
# 3) Put the 16-char password ONLY in local `.env` (not here)
#
# Recipients can be ANY domain (yahoo, outlook, university.edu, …).
# Only the *sending* account needs to be Gmail SMTP.
SMTP_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=1
SMTP_USER=your-gmail@gmail.com
SMTP_FROM=your-gmail@gmail.com
SMTP_PASSWORD=your-16-char-gmail-app-password

# Set to 0 once real SMTP works (hides debug_code in API responses)
AUTH_DEV_SHOW_OTP=0
