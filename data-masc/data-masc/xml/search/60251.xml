ible-to-user="False" package="com.handyapps.tipnsplit" enabled="True" pressed="not_pressed" scrollable-vertical="False"><wrapper><node value="android.widget.TextView" /><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="0" /><node value="0" /><node value="0" /><node value="0" /></wrapper><wrapper><node value="274" /><node value="280" /><node value="274" /><node value="-30" /></wrapper></node></wrapper><wrapper><node value="android.view.ViewGroup" /><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="274" /><node value="56" /><node value="1415" /><node value="280" /></wrapper><wrapper><node value="274" /><node value="280" /><node value="1415" /><node value="193" /></wrapper></node></wrapper></node><node resource-id="com.handyapps.tipnsplit:id/tipping_guide_country_container" adapter-view="False" pointer="aefa577" scrollable-horizontal="False" selected="False" draw="True" focusable="False" long-clickable="False" visibility="visible" focused="False" clickable="False" abs-pos="True" class="android.widget.LinearLayout" visible-to-user="True" package="com.handyapps.tipnsplit" enabled="True" pressed="not_pressed" scrollable-vertical="False"><wrapper><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="RESTAURANTS" focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="d7de5e4" class="android.widget.TextView" visible-to-user="True"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="25" /><node value="280" /><node value="1415" /><node value="384" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="25" /><node value="0" /><node value="1415" /><node value="135" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="A 15% tip is expected by your server for good service and up to 20% if the service is exceptional, similar to the practices in the United States. If a service charge (propina) is added to the bill (usually 10%), then a tip/gratuity is not required to be given." focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="cfe8a4d" class="android.widget.TextView" visible-to-user="True"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="25" /><node value="384" /><node value="1415" /><node value="621" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="25" /><node value="135" /><node value="1415" /><node value="372" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="BARS" focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="b128902" class="android.widget.TextView" visible-to-user="True"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="25" /><node value="621" /><node value="1415" /><node value="756" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="25" /><node value="372" /><node value="1415" /><node value="507" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="10-20 pesos with every drink OR 15% for the whole bill if you are keeping an open tab." focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="62f2213" class="android.widget.TextView" visible-to-user="True"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="25" /><node value="756" /><node value="1415" /><node value="879" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="25" /><node value="507" /><node value="1415" /><node value="630" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="HOTEL STAFF" focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="c257c50" class="android.widget.TextView" visible-to-user="True"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="25" /><node value="879" /><node value="1415" /><node value="1014" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="25" /><node value="630" /><node value="1415" /><node value="765" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="- Porters: 10-20 per bag carried.&#10;- Housekeeping: 10-20 pesos per day.&#10;- Concierge: A tip of 50-100 pesos is a fair tip to a concierge who has served you well." focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="db67e49" class="android.widget.TextView" visible-to-user="True"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="25" /><node value="1014" /><node value="1415" /><node value="1251" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="25" /><node value="765" /><node value="1415" /><node value="1002" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="TAXI DRIVERS" focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="6a4334e" class="android.widget.TextView" visible-to-user="True"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="25" /><node value="1251" /><node value="1415" /><node value="1386" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="25" /><node value="1002" /><node value="1415" /><node value="1137" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="No tip necessary. Rounding up to the nearest 10 peso is more than sufficient." focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="7dfcc6f" class="android.widget.TextView" visible-to-user="True"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="25" /><node value="1386" /><node value="1415" /><node value="1509" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="25" /><node value="1137" /><node value="1415" /><node value="1260" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="TOUR GUIDES" focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="76e0d7c" class="android.widget.TextView" visible-to-user="True"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="25" /><node value="1509" /><node value="1415" /><node value="1644" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="25" /><node value="1260" /><node value="1415" /><node value="1395" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="50-70 pesos per day." focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="bdfb605" class="android.widget.TextView" visible-to-user="True"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="25" /><node value="1644" /><node value="1415" /><node value="1710" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="25" /><node value="1395" /><node value="1415" /><node value="1461" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="UNDERSTANDING MORE" focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="494365a" class="android.widget.TextView" visible-to-user="True"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="25" /><node value="1710" /><node value="1415" /><node value="1845" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="25" /><node value="1461" /><node value="1415" /><node value="1596" /></wrapper></node><node scrollable-horizontal="False" draw="False" clickable="False" pressed="not_pressed" text="Tipping (la propina) is part and parcel of life in the Mexican service industry. Wages of hospitality staff in Mexico is generally very low and many of them supplement their daily wages with tips. you will encounter situations where you have to tip all the time, for example like when a carpark warden helps you guide your car into a car park, or when an attendant in the bathroom helps you with a towel to dry your hands. Remember to keep small change available for these 10 peso tips because small change isn't always easy to find in Mexico." focusable="False" long-clickable="False" enabled="True" visibility="visible" focused="False" selected="False" scrollable-vertical="False" adapter-view="False" abs-pos="True" pointer="f46c08b" class="android.widget.TextView" visible-to-user="True"><wrapper><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="25" /><node value="1845" /><node value="1415" /><node value="2367" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="25" /><node value="1596" /><node value="1415" /><node value="2118" /></wrapper></node></wrapper><wrapper><node value="android.view.ViewGroup" /><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="0" /><node value="336" /><node value="1440" /><node value="2454" /></wrapper><wrapper><node value="0" /><node value="280" /><node value="1440" /><node value="2367" /></wrapper></node></wrapper></node></wrapper></node></wrapper></node></wrapper><wrapper><node value="android.widget.FrameLayout" /><node value="android.view.ViewGroup" /><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="0" /><node value="0" /><node value="1440" /><node value="2392" /></wrapper><wrapper><node value="0" /><node value="0" /><node value="1440" /><node value="2392" /></wrapper></node></wrapper><wrapper><node value="android.widget.LinearLayout" /><node value="android.view.ViewGroup" /><node value="android.view.View" /><node value="java.lang.Object" /></wrapper><wrapper><node value="None" /></wrapper><wrapper><node value="0" /><node value="0" /><node value="1440" /><node value="2392" /></wrapper><wrapper><node value="0" /><node value="0" /><node value="1440" /><node value="2392" /></wrapper></node></wrapper></node></wrapper></node><node resource