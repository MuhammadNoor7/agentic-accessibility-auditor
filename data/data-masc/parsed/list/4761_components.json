    {
      "component_id": "c_076",
      "class": "android.support.v7.widget.AppCompatTextView",
      "text": "Heat a heavy bottomed saute pan over medium-high heat. Test the pan's heat with a piece of onion; if it sizzles the pan is the right heat and all the onions can be added. Stir the onions in the pan; they will stick and that's ok. Let them get some color, and then add 1/4 cup warm water a little at a time to loosen them. Let it reduce down until the onions are translucent.",
      "content_desc": "",
      "resource_id": "com.desertstorm.recipebook:id/direction",
      "clickable": false,
      "enabled": true,
      "focusable": false,
      "bounds": [
